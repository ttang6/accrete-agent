# ───────────── 主 LLM（必填，OpenAI 兼容接口）─────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_ID=gpt-5.4-mini
# OPENAI_TIMEOUT=60

# ───────────── 副 LLM / 其它 provider（可选；缺失则自动降级跳过）─────────────
# 日报评审 evaluator + 偏好蒸馏 distiller 走 dashscope
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=

# ───────────── 搜索 tool（可选；任一存在即启用 SearchTool）─────────────
TAVILY_API_KEY=
EXA_API_KEY=

# ───────────── Telegram channel（仅 run_bot.py 需要）─────────────
TELEGRAM_BOT_TOKEN=
# 逗号分隔的 chat id 白名单
TELEGRAM_CHAT_ID=
